# source distribution: the package plus what is needed to test and read it
include CHANGELOG.md CITATION.cff
recursive-include tests *.py
recursive-include examples *.py *.ipynb
recursive-include tools *.py *.npz
include docs/*.md
recursive-include docs/images *.png
# reference material kept on disk, never shipped
prune docs/paper
prune docs/reference
global-exclude *.py[cod] __pycache__ *.nbc *.nbi
